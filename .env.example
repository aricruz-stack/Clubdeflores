# Copia este archivo como .env y completa los valores

# Puerto donde corre el servidor (Railway/Render lo suelen inyectar solos)
PORT=3000

# Credenciales del panel de administrador
ADMIN_USER=admin
ADMIN_PASSWORD=cambiar-esta-clave

# Clave secreta para firmar las sesiones (cualquier string largo y aleatorio)
SESSION_SECRET=cambiar-por-un-string-largo-y-random
